# Victim E-Commerce Backend Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=password
DATABASE_NAME=victim_ecommerce_db
MAINTENANCE_DB=postgres

# JWT (intentionally weak for demo)
JWT_SECRET=super-secret-key-123
JWT_ALGORITHM=HS256

# Vulnerability Mode (set to 'false' for safe mode)
VULN_MODE=true

# Upload directory for file download endpoint
UPLOAD_DIR=uploads
