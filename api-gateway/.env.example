# ── API Gateway Configuration ──

# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Upstream (Victim E-commerce backend)
UPSTREAM_BASE_URL=http://localhost:8081

# ML Engine
ML_ENGINE_URL=http://localhost:8000
ML_ENGINE_TIMEOUT=5.0

# Redis
REDIS_URL=redis://localhost:6379/0
BLOCKLIST_TTL=3600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REQUESTS=api.requests.raw
KAFKA_TOPIC_VERDICTS=api.verdicts

# Security
BLOCK_ON_ML_FAILURE=false
RISK_THRESHOLD_BLOCK=HIGH
