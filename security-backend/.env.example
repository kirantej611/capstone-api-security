# Security Backend Configuration
PORT=8082
KAFKA_BROKERS=localhost:9092
# Must match KAFKA_TOPIC_VERDICTS in docker-compose.yml (api-gateway env)
KAFKA_TOPIC=api.verdicts
REDIS_ADDR=localhost:6379
POSTGRES_URL=postgres://admin:password@localhost:5432/capstone_db?sslmode=disable
BLOCK_THRESHOLD=80.0
