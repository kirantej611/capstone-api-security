# Attack Simulator Configuration

# Target (the API Gateway, NOT the e-commerce backend directly)
GATEWAY_URL=http://localhost:8080

# Demo speed control
NORMAL_TRAFFIC_DELAY=1.0
ATTACK_TRAFFIC_DELAY=0.5
ANOMALOUS_TRAFFIC_DELAY=0.05

# Traffic mix (percentage, must sum to 100)
NORMAL_TRAFFIC_PCT=60
ATTACK_TRAFFIC_PCT=25
ANOMALOUS_TRAFFIC_PCT=15

# Duration (seconds, 0 = run forever)
DEMO_DURATION=120

# Credential stuffing
CREDENTIAL_STUFFING_BATCH_SIZE=50
